{
  "name": "flashlearn",
  "version": "1.0.0",
  "description": "AgentOne — a desktop launcher and capability manager for agent frameworks (zeptoclaw, hermes, openclaw) with local and cloud model backends.",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite --config vite.config.ts",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:preload": "tsc -p tsconfig.preload.json --watch",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:preload\" \"wait-on http://localhost:5173 && electron .\"",
    "clean": "rm -rf dist",
    "rebuild:electron": "cd node_modules/better-sqlite3 && node-gyp rebuild --target=23.3.13 --arch=arm64 --dist-url=https://electronjs.org/headers",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build": "npm run clean && npm run build:renderer && npm run build:main && npm run build:preload",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "electron": "^23.3.13",
    "electron-builder": "^26.15.3",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.0",
    "vite": "^4.5.14",
    "vitest": "^0.34.6",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "better-sqlite3": "^8.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
